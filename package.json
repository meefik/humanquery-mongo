{
  "name": "humanquery-mongo",
  "version": "1.0.2",
  "description": "A MongoDB query parser that converts human-readable search strings into MongoDB query syntax.",
  "author": "Anton Skshidlevsky <meefik@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meefik/humanquery-mongo.git"
  },
  "keywords": [
    "mongodb",
    "query",
    "parser",
    "search"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "node --test 'tests/**/*.test.js'"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.62.0"
  }
}
